generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================
// Auth Models
// =====================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user") // user | admin
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  products      Product[]
  activities    Activity[]
  couponUsage   CouponUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================
// Product Models
// =====================

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  storageCode   String?  @map("storage_code")
  title         String
  description   String
  shortDesc     String   @map("short_description")
  price         Float
  originalPrice Float?   @map("original_price")
  type          String   // template | source-code
  category      String
  technologies  String[]
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  downloadCount Int      @default(0) @map("download_count")
  version       String   @default("1.0.0")
  thumbnail     String
  images        String[]
  featured      Boolean  @default(false)
  isNew         Boolean  @default(false) @map("is_new")
  isBestseller  Boolean  @default(false) @map("is_bestseller")
  status        String   @default("active") // active | draft | archived
  zipUrl        String?  @map("zip_url")
  demoUrl       String?  @map("demo_url")
  authorId      String?  @map("author_id")
  lastUpdated   DateTime @default(now()) @map("last_updated")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author      User?         @relation(fields: [authorId], references: [id])
  reviews     Review[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlistItems WishlistItem[]

  @@index([type])
  @@index([category])
  @@index([featured])
  @@index([storageCode])
  @@map("products")
}

// =====================
// Order Models
// =====================

model Order {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  status      String   @default("pending") // pending | paid | failed | refunded
  total       Float
  coupon      String?
  discount    Float    @default(0)
  cfOrderId   String?  @map("cf_order_id")
  cfPaymentId String?  @map("cf_payment_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  price     Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// =====================
// Cart & Wishlist
// =====================

model CartItem {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  productId String @map("product_id")
  quantity  Int    @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// =====================
// Reviews
// =====================

model Review {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  rating    Int
  comment   String
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

// =====================
// Newsletter
// =====================

model Newsletter {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("newsletters")
}

// =====================
// Activity Log
// =====================

model Activity {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  action    String   // page_view, purchase, login, download, etc.
  details   String?  // JSON string with extra info
  metadata  String?  // IP, user agent, etc.
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activities")
}

// =====================
// Coupons
// =====================

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  String    @map("discount_type") // percentage | fixed
  discountValue Float     @map("discount_value") // e.g. 10 for 10% or ₹10 off
  minOrder      Float     @default(0) @map("min_order") // minimum order amount
  maxDiscount   Float?    @map("max_discount") // cap for percentage discounts
  usageLimit    Int?      @map("usage_limit") // total uses allowed (null = unlimited)
  usedCount     Int       @default(0) @map("used_count")
  perUserLimit  Int       @default(1) @map("per_user_limit") // uses per user
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  active        Boolean   @default(true)
  createdById   String?   @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  usages        CouponUsage[]

  @@index([code])
  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  usedAt    DateTime @default(now()) @map("used_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, orderId])
  @@map("coupon_usage")
}
